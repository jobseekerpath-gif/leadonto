# pnpm 10+ reads onlyBuiltDependencies / dangerouslyAllowAllBuilds from .npmrc
# as pnpm config. dangerously-allow-all-builds=true lets EVERY dependency run
# its postinstall script, so install never aborts with ERR_PNPM_IGNORED_BUILDS.
dangerously-allow-all-builds=true
auto-install-peers=false
strict-peer-dependencies=false